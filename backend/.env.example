# Server configuration
PORT=5000

# Database connection
MONGODB_URI=mongodb://localhost:27017/roommate-finder

# Development-only demo user seed (requires NODE_ENV=development)
DEV_DEMO_SEED=false
DEV_DEMO_USER_PASSWORD=replace_with_a_unique_password_at_least_12_chars

# JWT configuration
JWT_SECRET=your_jwt_secret_key_here

# Optional one-time administrator bootstrap (use a unique, strong password)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace_with_a_unique_password_at_least_12_chars
# Set to true temporarily to reset/promote the existing admin account, then remove or set to false
ADMIN_SEED_RESET_EXISTING=false

# Comma-separated frontend origins allowed by CORS (origin URLs only; no paths)
FRONTEND_URL=http://localhost:3000,https://roommate-finder-ashen.vercel.app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Config
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase Admin SDK Config (Backend)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Vietmap Configuration
VIETMAP_API_KEY=your_vietmap_api_key

# Email / SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=no-reply@roommatefinder.com
